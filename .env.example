# --- Google Drive (fightweightgain account) ---
# OAuth client from Google Cloud Console (type: Web application,
# redirect URI http://localhost:53682 for the one-time token mint).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mint with: node scripts/get-google-refresh-token.mjs (signed in as fightweightgain)
GOOGLE_REFRESH_TOKEN=

# Drive folder id of the parent "Rx forms" folder that contains the weekly
# dated subfolders. From its URL: https://drive.google.com/drive/folders/<THIS_ID>
RX_PARENT_FOLDER_ID=

# --- Slack ---
# Channel id (right-click channel → View channel details → bottom of About tab)
# where the Saturday scheduled run posts and asks for missing forms.
SLACK_CHANNEL_ID=
# Vercel Connect client UID for the Slack app (default: slack/rx-forms-agent).
# Created with: vercel connect create slack --triggers
SLACK_CONNECT_UID=slack/rx-forms-agent

# --- Optional: HTTP entry point ---
# Set BOTH to open POST /eve/v1/session to HTTP Basic auth for on-demand runs.
# Leave unset to keep the route closed (Slack and the Saturday cron are
# unaffected either way). Consult forms contain PHI, so never make this route
# anonymous. Generate a strong password, e.g. `openssl rand -base64 24`.
EVE_HTTP_AUTH_USER=
EVE_HTTP_AUTH_PASSWORD=

# --- Local development only ---
# On Vercel, model access uses OIDC via AI Gateway automatically. For
# `npm run dev` locally, create a key at https://vercel.com/d?to=/[team]/~/ai/api-keys
AI_GATEWAY_API_KEY=
